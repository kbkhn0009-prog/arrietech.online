# Required for lead form → Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Lead form email (arrietech.ru@gmail.com)
LEAD_EMAIL=arrietech.ru@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ARRIE <your@gmail.com>

# Cloudflare Web Analytics (dashboard → Web Analytics → Add site)
NEXT_PUBLIC_CF_BEACON_TOKEN=your_cf_beacon_token

# Optional: persist custom events to Supabase (table arrie_events)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
