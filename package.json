{
  "name": "arrie-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
  "dev": "next dev",
  "build": "next build",
  "start": "next start",
  "lint": "next lint",
  "pages:build": "npx @cloudflare/next-on-pages",
  "pages:dev": "npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
  "preview": "npm run pages:build && npm run pages:dev",
  "deploy": "npm run pages:build && npx wrangler pages deploy --project-name=arrie-nextjs --commit-dirty=true"
},
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.6",
    "lenis": "^1.1.13",
    "maath": "^0.10.8",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-intersection-observer": "^10.0.3",
    "tailwind-merge": "^2.5.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.15",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.92.0"
  }
}
